{
  "name": "ipas-ai-term-match",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{"binding": "DB", "database_name": "ipas-adventure", "database_id": "REPLACE_WITH_FREE_D1_DATABASE_ID"}],
  "observability": {"enabled": false}
}
